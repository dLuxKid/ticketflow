# Copy this file to backend/.env.docker and fill in real values. .env.docker is gitignored
# (see .dockerignore / root .gitignore's .env*.local + .env patterns) - never commit real
# secrets here. docker-compose.yml's `backend` service loads this via env_file.
#
# DB and PORT are set directly in docker-compose.yml (pointing at the mongo service inside
# the compose network) and don't need to be repeated here.

JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=

GMAIL_HOST=smtp.gmail.com
GMAIL_SERVICE=gmail
GMAIL_PORT=587
GMAIL_EMAIL=
GMAIL_PASSWORD=
EMAIL_FROM=

DEV_FRONTEND_URL=http://localhost:3000
PROD_FRONTEND_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=

# AI concierge chatbot (Phase 8) - OpenAI primary, Gemini fallback. Chat works without
# these (falls back to a graceful "unavailable" reply) but won't answer anything real.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CHAT_RATE_LIMIT_PER_HOUR=20
