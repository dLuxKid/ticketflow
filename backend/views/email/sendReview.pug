    a[x-apple-data-detectors='true'] {
    color: inherit !important;
    text-decoration: none !important;
    }
    table,
    td {
    color: #000000;
    }
    #u_body a {
    color: #161a39;
    text-decoration: underline;
    }
    @media (max-width: 480px) {
    #u_column_4 .v-col-background-color {
